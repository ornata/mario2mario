# Stable command-line names for the oracle interpreter in //src/oracle.
#   bazelisk run //oracle:run -- [--rom PATH] [--max-insns N] [--trace PATH]
#                                [--replay F.rec] [--task-hashes F.txt]
#                                [--checkpoints PATH] [--checkpoint-stride N]

package(default_visibility = ["//visibility:public"])

alias(
    name = "run",
    actual = "//src/oracle:run",
)

#   bazelisk run //oracle:play -- [--replay F.rec] [--record F.rec] [--scale N]
#                                 [--headless --frames N --png OUT.png] [--fields N]
alias(
    name = "play",
    actual = "//src/rcp:play",
)
