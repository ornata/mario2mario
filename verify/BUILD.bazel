load("@rom//:defs.bzl", "ROM_PATH")

# Publish-safety check: no ROM-derived content (runs of ROM words, raw ROM
# bytes) in any git-tracked file or in any blob of the git history, except
# the line-anchored allowlist of deliberate excerpts
# (verify/publish_allowlist.tsv). Reads the repository, so it runs
# unsandboxed.
sh_test(
    name = "publish_check",
    size = "medium",
    srcs = ["publish_check.sh"],
    data = [
        "publish_allowlist.tsv",
        "publish_check.py",
    ],
    env = {"M2M_ROM": ROM_PATH},
    tags = [
        "external",
        "local",
    ],
)

# Provenance verifier: machine-checks the no-decompilation claim over every
# unit in gen/units/ (source order, bounded per-instruction ranges,
# address-derived labels, no code motion, CFG isomorphism, provenance
# words == footer == listing == ROM), then runs its mutation self-test.
sh_test(
    name = "provenance",
    size = "medium",
    srcs = ["provenance.sh"],
    data = [
        "provenance.py",
        "provenance_selftest.py",
        "//gen:provenance_selftest_data",
        "//gen:unit_listings",
        "//gen:unit_sources",
    ],
    env = {"M2M_ROM": ROM_PATH},
    tags = [
        "external",
        "manual",
    ],
)

# Coverage ledger as a test: 0 executed pairs of the full route uncovered.
sh_test(
    name = "coverage",
    size = "small",
    srcs = ["coverage.sh"],
    data = [
        "//gen:coverage_inputs",
        "//gen:unit_sources",
    ],
    tags = ["manual"],
)

# ROM-history guard: scans every object in the repository's git store.
sh_test(
    name = "rom_history",
    size = "small",
    srcs = ["rom_history.sh"],
    data = ["rom_history.py"],
    env = {"M2M_ROM": ROM_PATH},
    tags = [
        "external",
        "local",
    ],
)

# The publishable-repository checks: they need only the ROM, not the
# translated units.
test_suite(
    name = "public",
    tests = [
        ":publish_check",
        ":rom_history",
    ],
)

# The full verification suite (PLAN.md): lockstep + provenance + coverage
# ledger + ROM-history guard, plus the per-opcode stub harness. Needs the
# translated units in gen/units/, regenerated per PROMPT.md.
test_suite(
    name = "all",
    # manual: otherwise //... would expand this suite and run its
    # translation-dependent members.
    tags = ["manual"],
    tests = [
        ":coverage",
        ":provenance",
        ":rom_history",
        "//src/native:full_route_lockstep_test",
        "//src/native:opcode_stub_test",
    ],
)
