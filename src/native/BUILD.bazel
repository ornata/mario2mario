load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_test")

package(default_visibility = ["//visibility:public"])

exports_files(["m2m.inc"])

cc_library(
    name = "headers",
    hdrs = ["native.h"],
    deps = [
        "//src/hw",
        "//src/oracle:state",
    ],
)

# Runtime: entry/exit glue, trampolines and C services. Links against the
# translated units in //gen:units.
cc_library(
    name = "runtime",
    srcs = [
        "entry.s",
        "runtime.c",
        "units_section.s",
    ],
    textual_hdrs = ["m2m.inc"],
    # The (possibly empty) __m2m_units section must exist for the linker's
    # section$start/end symbols; an empty descriptor section is provided.
    deps = [
        ":headers",
        "//gen:units",
        "//src/hw",
        "//src/oracle:state",
    ],
)

cc_binary(
    name = "run",
    srcs = ["run.c"],
    deps = [
        ":runtime",
        "//src/hw",
        "//src/oracle:state",
        "//src/rcp:gfx",
        "//src/rcp:input",
        "//src/tools:z64",
    ],
)

cc_binary(
    name = "stubgen",
    srcs = ["stubgen.c"],
)

genrule(
    name = "stubs",
    srcs = ["//gen:unit_sources"],
    outs = ["stubs.s"],
    cmd = "$(location :stubgen) $@ $(SRCS)",
    tools = [":stubgen"],
)

# Phase 5.1 per-opcode check: one translated group per opcode form vs the
# oracle over fixed-seed random states. Grows with gen/units coverage.
cc_test(
    name = "opcode_stub_test",
    size = "small",
    srcs = [
        "opcode_stub_test.c",
        ":stubs",
    ],
    deps = [
        ":runtime",
        "//src/hw",
        "//src/oracle",
        "//src/tools:mips",
    ],
)

# //native:play: the shared window/input/replay front end (src/rcp/play.c)
# built against the native runtime instead of the oracle.
cc_binary(
    name = "play",
    srcs = ["//src/rcp:play.c"],
    defines = ["M2M_NATIVE_ENGINE"],
    deps = [
        ":runtime",
        "//src/hw",
        "//src/oracle",
        "//src/rcp:gfx",
        "//src/rcp:gl",
        "//src/rcp:input",
        "//src/rcp:png",
        "//src/tools:z64",
        "@sdl2",
    ],
)
