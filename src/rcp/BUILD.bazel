load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_test")

package(default_visibility = ["//visibility:public"])

# GL-free Fast3D display-list HLE and texture decoding.
cc_library(
    name = "gfx",
    srcs = [
        "gfx.c",
        "texture.c",
    ],
    hdrs = [
        "gfx.h",
        "texture.h",
    ],
    deps = ["//src/hw"],
)

cc_test(
    name = "gfx_test",
    size = "small",
    srcs = ["gfx_test.c"],
    deps = [
        ":gfx",
        "//src/hw",
    ],
)

cc_library(
    name = "png",
    srcs = ["png.c"],
    hdrs = ["png.h"],
)

cc_library(
    name = "gl",
    srcs = ["gl.c"],
    hdrs = ["gl.h"],
    deps = [
        ":gfx",
        "//third_party:gl",
    ],
)

cc_library(
    name = "input",
    srcs = ["input.c"],
    hdrs = ["input.h"],
    deps = ["//src/hw"],
)

cc_test(
    name = "input_test",
    size = "small",
    srcs = ["input_test.c"],
    deps = [":input"],
)

cc_binary(
    name = "recgen",
    srcs = ["recgen.c"],
    deps = [":input"],
)

cc_binary(
    name = "play",
    srcs = ["play.c"],
    deps = [
        ":gfx",
        ":gl",
        ":input",
        ":png",
        "//src/hw",
        "//src/oracle",
        "//src/tools:z64",
        "@sdl2",
    ],
)
