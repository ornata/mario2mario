load("@rom//:defs.bzl", "ROM_PATH")
load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_test")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "oracle",
    srcs = [
        "boot.c",
        "checkpoint.c",
        "cpu.c",
        "fpu.c",
        "trace.c",
    ],
    hdrs = [
        "boot.h",
        "checkpoint.h",
        "cpu.h",
        "trace.h",
    ],
    # fpu.c needs the host rounding mode and IEEE flags honoured exactly.
    copts = ["-ffp-model=strict"],
    deps = ["//src/hw"],
)

cc_binary(
    name = "run",
    srcs = ["run.c"],
    deps = [
        ":oracle",
        "//src/hw",
        "//src/rcp:gfx",
        "//src/rcp:input",
        "//src/tools:z64",
    ],
)

cc_test(
    name = "opcode_test",
    size = "small",
    srcs = ["opcode_test.c"],
    deps = [
        ":oracle",
        "//src/hw",
        "//src/tools:mips",
    ],
)

# Boots the real ROM (path via $M2M_ROM, see bazel/rom.bzl); not cached.
cc_test(
    name = "boot_milestone_test",
    size = "small",
    srcs = ["boot_milestone_test.c"],
    env = {"M2M_ROM": ROM_PATH},
    tags = ["external"],
    deps = [
        ":oracle",
        "//src/hw",
        "//src/tools:rom_env",
        "//src/tools:z64",
    ],
)
