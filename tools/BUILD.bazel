# Stable command-line names for the mechanical tooling in //src/tools.
#   bazelisk run //tools:listing -- <rom.z64> <rom_start> <rom_end> <ram_base>

package(default_visibility = ["//visibility:public"])

alias(
    name = "listing",
    actual = "//src/tools:listing",
)

# Full-ROM decode -> text -> encode bijectivity (reads the ROM via $M2M_ROM).
alias(
    name = "decoder_roundtrip_test",
    actual = "//src/tools:decoder_roundtrip_test",
)

#   bazelisk run //tools:chunker -- [--target N] <listing.txt>
alias(
    name = "chunker",
    actual = "//src/tools:chunker",
)

#   bazelisk run //tools:recgen -- SCRIPT.txt OUT.rec
alias(
    name = "recgen",
    actual = "//src/rcp:recgen",
)
